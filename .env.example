# SafeWalk Frontend — Environment Variables Template
# Copy this file to .env for local development or configure in your deployment platform (e.g. Vercel).
# NOTE: Vite exposes VITE_* variables to client-side code. Never place secrets or private keys in them.

# Production API Base URL (Railway):
# VITE_API_BASE_URL=https://safewalk-backend-production-e3a1.up.railway.app/api/v1

# Local Development API Base URL (Default for local Docker / Spring Boot):
VITE_API_BASE_URL=http://localhost:8080/api/v1
